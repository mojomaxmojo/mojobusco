legacy-peer-deps=true
# @nostrify/nostrify und @nostrify/react werden über JSR bezogen
# (npm:@jsr/nostrify__nostrify, npm:@jsr/nostrify__react). Ohne diese
# Zeile versucht npm, den @jsr-Scope vom normalen npm-Registry
# (registry.npmjs.org) zu laden -> 404, weil dort nicht existent.
# Offizielle JSR-npm-Kompatibilitätsschicht: https://jsr.io/docs/npm-compatibility
@jsr:registry=https://npm.jsr.io
# npm 12 setzt allow-remote standardmäßig auf "none" und blockiert dadurch
# @nostrify/react (JSR-Paket, Tarball wird von npm.jsr.io statt vom
# konfigurierten Registry-Host ausgeliefert) mit EALLOWREMOTE.
# Siehe: https://github.com/npm/cli/issues/9548
allow-remote=all