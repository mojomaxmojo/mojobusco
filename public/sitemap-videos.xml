<?xml version="1.0" encoding="UTF-8"?>
<!--
  Statische Fallback-Video-Sitemap.
  Der Cron-Job (scripts/generate-sitemap.js) überschreibt diese Datei
  täglich mit der vollständigen Version aus den Nostr-Video-Events.
  Zweck: Niemals leere urlset ausliefern (Google-Fehler
  "Fehlendes XML-Tag: url") und niemals die SPA-index.html
  (Nginx try_files Fallback) als Sitemap servieren.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  <url>
    <loc>https://mojobus.co/videos</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
