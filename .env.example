# .env.example — Vorbild-Datei (Berichte-Assistent + allgemeine Server-Variablen)
#
# Echte Werte gehören in DIE EINE Env-Datei des ai-api-Service:
#   /etc/systemd/system/ai-api.env   (systemd: EnvironmentFile=/etc/systemd/system/ai-api.env)
#   root:root, chmod 600 — NIEMALS in den Nginx-Webroot legen, NIEMALS committen!
# Dort auch die bestehenden Keys (OPENROUTER_API_KEY, XAI_API_KEY, GROQ_API_KEY,
# FFMPEG_PATH) sammeln — keine Secrets mehr hartcodiert in ai-api.service.
# Nach Änderungen am Env-Inhalt: `systemctl restart ai-api`
# (daemon-reload nur nötig, wenn die Unit-Datei selbst geändert wurde).
#
# Ausführliche Migrations-Schritte: docs/CONTEXT_DEPLOY.md
#   Abschnitt „Berichte-Assistent — Env-Variablen + Restart"

# ── KI (vorhanden) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Google Search Console (Service-Account, read-only) ─────────────────────
# Service-Account in der Search Console als Owner/Benutzer eintragen.
# GSC_PRIVATE_KEY = PEM-Private-Key; \n-Escapes sind erlaubt.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:mojobus.co

# ── IndexNow (Verifikationsdatei: public/<KEY>.txt) ────────────────────────
# Der Key ist per Design öffentlich — er muss mit der Datei im Webroot
# übereinstimmen. Aktuell gesetzter Key: f4a9c2e17b8d3a65c0e94f21d7b58a03
# (Datei: public/f4a9c2e17b8d3a65c0e94f21d7b58a03.txt)
INDEXNOW_KEY=

# ── Berichte-Assistent: Schreib-Schutz (Drafts, Upload, Published) ─────────
# Zufälligen Token erzeugen, z. B.:  openssl rand -hex 32
ASSISTANT_API_TOKEN=

# ── Media-Library (lokale Bild-Bibliothek auf dem VPS) ─────────────────────
MEDIA_DIR=/home/nginx/domains/mojobus.co/public/images/articles
MEDIA_PUBLIC_BASE=https://mojobus.co/images/articles

# ── Build-seitig (Frontend-Bundle, in .env.production) ──────────────────────
# VITE_ASSISTANT_TOKEN=<gleiches Token wie ASSISTANT_API_TOKEN>
#
# ⚠ TRANSPARENTER HINWEIS: Das VITE_-Token liegt im Frontend-Bundle und ist
# damit technisch für Bundle-Leser sichtbar. Es schützt gegen Skript-Bots,
# nicht gegen gezieltes Auslesen. Optional härter machbar via Nginx-Basic-Auth
# auf den Write-Routen (später entscheidbar).
