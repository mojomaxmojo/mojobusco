# .env.example — Vorbild-Datei (Berichte-Assistent + allgemeine Server-Variablen)
#
# Echte Werte gehören in DIE EINE Env-Datei des ai-api-Service:
#   /etc/systemd/system/ai-api.env   (systemd: EnvironmentFile=/etc/systemd/system/ai-api.env)
#   root:root, chmod 600 — NIEMALS in den Nginx-Webroot legen, NIEMALS committen!
# Dort auch die bestehenden Keys (OPENROUTER_API_KEY, XAI_API_KEY, GROQ_API_KEY,
# FFMPEG_PATH) sammeln — keine Secrets mehr hartcodiert in ai-api.service.
# Nach Änderungen am Env-Inhalt: `systemctl restart ai-api`
# (daemon-reload nur nötig, wenn die Unit-Datei selbst geändert wurde).
#
# Ausführliche Migrations-Schritte: docs/CONTEXT_DEPLOY.md
#   Abschnitt „Berichte-Assistent — Env-Variablen + Restart"

# ── KI (vorhanden) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Google Search Console (Service-Account, read-only) ─────────────────────
# Service-Account in der Search Console als Owner/Benutzer eintragen.
# GSC_PRIVATE_KEY = PEM-Private-Key; \n-Escapes sind erlaubt.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:mojobus.co

# ── IndexNow (Verifikationsdatei: public/<KEY>.txt) ────────────────────────
# Der Key ist per Design öffentlich — er muss mit der Datei im Webroot
# übereinstimmen. Aktuell gesetzter Key: f4a9c2e17b8d3a65c0e94f21d7b58a03
# (Datei: public/f4a9c2e17b8d3a65c0e94f21d7b58a03.txt)
INDEXNOW_KEY=

# ── KI-Routen-Schutz (NIP-98, nur Autoren aus src/config/authors.json) ─────
# AI_AUTH_REQUIRED=1  → KI-/CPU-/Credit-Routen (generate-*, tiktok, render-*
#                       remotion, assistant, promotion …) verlangen ein
#                       gültiges, mit einem Autoren-Pubkey signiertes
#                       NIP-98-Auth-Event (kind 27235). Details:
#                       server/middleware/nostr-auth.js
# AI_AUTH_REQUIRED=0  → Rollout-Modus: alles offen (Start-Log warnt).
# Prefix-Liste: src/config/api-auth.js (auch vom Frontend genutzt).
# Frontend braucht KEINEN Token mehr — authedFetch (src/lib/apiAuth.ts)
# signiert mit dem Login des Autors (NIP-07/nsec/Bunker).
AI_AUTH_REQUIRED=0

# ── Berichte-Assistent: Schreib-Schutz (Drafts, Upload, Published) ─────────
# ⚠ DEPRECATED (2026-09): Die 🔒-Routen nutzen jetzt denselben NIP-98-Schutz
# wie alle KI-Routen (server/routes/assistant/auth.js → requireAuthor).
# ASSISTANT_API_TOKEN kann aus ai-api.env entfernt werden, sobald das
# Frontend mit authedFetch deployed ist. Zufalls-Token wäre gewesen:
#   openssl rand -hex 32
# ASSISTANT_API_TOKEN=

# ── Media-Library (lokale Bild-Bibliothek auf dem VPS) ─────────────────────
MEDIA_DIR=/home/nginx/domains/mojobus.co/public/images/articles
MEDIA_PUBLIC_BASE=https://mojobus.co/images/articles

# ── Band-Schätzung (Themen mit Nachfrage — Default-Pfad statt DataForSEO) ──
# Zahlen-BÄNDER aus festem Raster + grobe Saison-Kurve via Flash-Modell
# (Freigabe 2026-09-02, siehe FEATURE-BAND-SCHAETZUNG-PLAN.md).
# Speicher: data/band-estimates.json (DATA_DIR bzw. VPS-Public-Data-Verzeichnis)
# Alle Werte optional:
# BAND_ESTIMATE_ENABLED=1        # 0 = Feature aus (dann nur GSC/DFS)
# BAND_MODEL_TIER=test           # Tier aus server/config/ai-models.js („test" = GLM 5.3 Flash)
# BAND_CACHE_TTL_DAYS=7          # TTL der band-estimates.json-Einträge
# BAND_MAX_RUNS_PER_DAY=5        # echte Flash-Runs/Tag (Cache-Zugriffe zählen nicht)
# BAND_MAX_KEYWORDS_PER_RUN=40   # Deckel pro Flash-Run (Rest bleibt ohne Band)

# ── DataForSEO (OPT-IN pro Abruf — verbraucht Credits) ─────────────────────
# Wird nur genutzt, wenn die „DataForSEO"-Checkbox im Assistenten-Block
# aktiviert ist (Standard AUS). Ohne Keys degradiert der Flow auf Band/GSC.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_LOCATION_CODE=2276  # 2276 = Germany
# DATAFORSEO_LANGUAGE_NAME=German

# ── Build-seitig (Frontend-Bundle, in .env.production) ──────────────────────
# ⚠ DEPRECATED: VITE_ASSISTANT_TOKEN wird nicht mehr verwendet — die
# 🔒-Routen (Drafts/Upload/Published) und alle KI-Routen sind jetzt über
# NIP-98 (authedFetch, src/lib/apiAuth.ts) an die Autoren-Logins gebunden.
# Kein Secret mehr im Bundle nötig.

# ── Umami Analytics (self-hosted auf dem VPS: analytics.mojobus.co) ────────
# Werte werden primär in src/config/umami.ts gepflegt (DEFAULT_WEBSITE_ID
# nach dem VPS-Setup eintragen). Env-Variablen überschreiben die Defaults —
# nützlich für Staging oder wenn die ID nicht ins Repo soll.
# VITE_UMAMI_WEBSITE_ID=                       # UUID aus dem Umami-Dashboard
# VITE_UMAMI_SCRIPT_URL=                       # default: https://analytics.mojobus.co/script.js
# VITE_UMAMI_DOMAINS=                          # default: mojobus.co (Komma-Liste, localhost trackt nie)
# VITE_UMAMI_ENABLED=0                         # 0 = Tracking hart aus (auch bei gesetzter ID)
